// Reglas de seguridad para Firestore - TakTak Plataforma de vídeos y juegos
// Administradores Oficiales:
//   - elmalayaso7@gmail.com (Cuenta Madre)
//   - eliecerdepablos@gmail.com
//   - taktak.messenger@gmail.com
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para identificar Administradores Oficiales de TakTak
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'elmalayaso7@gmail.com' ||
        request.auth.token.email == 'eliecerdepablos@gmail.com' ||
        request.auth.token.email == 'taktak.messenger@gmail.com'
      );
    }
    
    // Reglas para la colección de posts (vídeos y juegos)
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && 
                    request.resource.data.keys().hasAll(['videoUrl', 'ownerId', 'createdAt']);
      allow update, delete: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.ownerId);
    }

    // Reglas para perfiles de usuario
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // Reglas para comentarios
    match /posts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if isAdmin() || (request.auth != null && (request.auth.uid == resource.data.userId || request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.ownerId));
    }

    // Reglas para puntuaciones de minijuegos
    match /game_scores/{scoreId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // Reglas para configuración de la plataforma (solo admins)
    match /platform_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reglas para reportes / moderación
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow delete: if isAdmin();
    }
  }
}
