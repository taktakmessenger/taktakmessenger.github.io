# Copy to backend/.env (or export in your shell) before running the API.
# Values shown are development defaults.

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/taktak

# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d

# Comma-free single origin, or * for local development.
CORS_ORIGIN=*

# TTC economy: 75% al creador / 25% a la plataforma (deben sumar 1).
CREATOR_SHARE=0.75
PLATFORM_SHARE=0.25

# Subidas de video y transcodificación HLS.
# Tamaño máximo por archivo, en bytes (50 MB por defecto).
MAX_VIDEO_BYTES=52428800
# Carpeta donde se guardan los originales y las versiones HLS.
UPLOADS_DIR=./uploads
# Actívalo solo si ffmpeg está instalado en el sistema. Con esto activado, todo
# vídeo subido (incluido el HEVC/H.265 de un iPhone) se convierte en H.264/AAC,
# que es lo único que reproducen todos los navegadores. Con esto en false, un
# .mp4 de iPhone se sirve tal cual y no se ve ni se oye en el navegador.
TRANSCODE_ENABLED=true
# Ruta del binario. Un nombre simple se busca en el PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Pagos: sin PAYMENT_WEBHOOK_SECRET el endpoint queda cerrado.
PAYMENT_WEBHOOK_SECRET=
# Paquetes de monedas (JSON). Los precios son la fuente de verdad del cobro.
# COIN_PACKAGES=[{"id":"starter","coins":70,"priceUsd":0.99}]

# Modelo de recomendación del feed.
# Pesos relativos de cada señal (solo importan sus proporciones).
FEED_WEIGHT_LIKE=3
FEED_WEIGHT_COMMENT=4
FEED_WEIGHT_SHARE=6
FEED_WEIGHT_GIFT=10
FEED_WEIGHT_VIEW=1
FEED_WEIGHT_COMPLETE=2
# Horas para que la popularidad de un video pierda la mitad de su peso.
FEED_HALF_LIFE_HOURS=48
# Ventana e intensidad del impulso de exploración para videos nuevos.
FEED_COLD_START_HOURS=6
FEED_EXPLORATION_BONUS=0.6
# Impresiones a partir de las cuales un video ya no recibe impulso.
FEED_IMPRESSION_FLOOR=200
# Máximo de videos de un mismo creador por página.
FEED_MAX_PER_CREATOR=2
# Tamaño del conjunto de candidatos antes de ordenar.
FEED_CANDIDATE_POOL=300

# URL pública de la app. Los enlaces de correo deben ser absolutos y no pueden
# construirse desde la cabecera Host (la controla el atacante).
APP_URL=http://localhost:12000

# Códigos de un solo uso (verificar correo/teléfono, recuperar contraseña).
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Pimienta para el hash de los códigos. Sin ella, un volcado de la base deja
# enumerar los 1.000.000 de códigos posibles.
OTP_PEPPER=

# SMS. Sin proveedor el código se registra en consola en vez de enviarse, y la
# ruta lo reporta como "delivered: false" en lugar de fingir que se envió.
# Proveedor soportado: twilio.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Llamadas a teléfonos que NO tienen la app (red telefónica, PSTN).
# Con VOICE_PROVIDER=twilio el navegador marca por Twilio Voice y el teléfono
# suena con su marcador normal, sin instalar nada. Sin proveedor, el marcador
# cae al marcador nativo del sistema (tel:), que en móvil abre la app de
# teléfono. Un número sin la app no puede recibir una videollamada WebRTC: no
# hay dónde entregarle la invitación, igual que en WhatsApp.
VOICE_PROVIDER=
# Número que verá quien recibe la llamada. Si se omite, se usa TWILIO_FROM_NUMBER.
TWILIO_VOICE_FROM=
# Credenciales del cliente de voz. Twilio separa el auth token (firma la API)
# de las API Keys (firman los tokens del navegador): una API Key se revoca sin
# cambiar el auth token de toda la cuenta.
TWILIO_API_KEY=
TWILIO_API_SECRET=
# TwiML App de Twilio que apunta a <APP_URL>/api/calls/twiml.
TWILIO_TWIML_APP_SID=
# TTC-R por minuto de llamada a teléfono normal. 0 = gratis.
VOICE_COST_PER_MINUTE=0

# Correo (verificación y recuperación de contraseña).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TAK TAK <no-reply@taktak.app>

# Inicio de sesión con Google. Sin client id la ruta queda cerrada: aceptar
# cualquier token sería un agujero de autenticación.
GOOGLE_CLIENT_ID=

# Sesión. El token de acceso es corto; el de refresco sostiene la sesión y se
# firma con un secreto distinto, así que un token de acceso no sirve como
# refresco.
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_SECRET=

# Notificaciones push (Web Push). Sin estas claves, una llamada a alguien que no
# tiene la app abierta no suena: el servidor no puede despertar su dispositivo.
# Se generan una sola vez con `npm run push:keys` y no hace falta cuenta de
# ningún proveedor.
#
# La privada es un secreto: va en el gestor de secretos, nunca al repositorio.
# Si se cambia, todas las suscripciones existentes dejan de valer y cada usuario
# tendrá que reactivar las notificaciones.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del responsable, que los servicios de push usan para avisar de abuso.
VAPID_SUBJECT=mailto:admin@taktak.app
