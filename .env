# Variables de entorno Firebase y Backend para TakTak Web
VITE_FIREBASE_API_KEY=AIzaSySampleApiKeyTaktak2026SecureExample
VITE_FIREBASE_AUTH_DOMAIN=taktak-app-firebase.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=taktak-app-firebase
VITE_FIREBASE_STORAGE_BUCKET=taktak-app-firebase.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef0123456789
VITE_BASE_URL=http://localhost:3000
VITE_API_URL=http://localhost:4000

# Compatibilidad con Next.js / React
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSySampleApiKeyTaktak2026SecureExample
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=taktak-app-firebase.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=taktak-app-firebase
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=taktak-app-firebase.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SET=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef0123456789
NEXT_PUBLIC_BASE_URL=http://localhost:3000
